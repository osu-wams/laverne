{
  "name": "osu-wams/laverne",
  "type": "drupal-custom-module",
  "description": "Manage shURLy short URLs.",
  "minimum-stability": "stable",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matthew Brabham",
      "email": "matthew.brabham@oregonstate.edu"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "scripts": {
    "cs-checkstyle": "phpcs -q --report=checkstyle",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "twigcs": "twigcs"
  },
  "conflict": {
    "drush/drush": "<13.7"
  },
  "require": {
    "drush/drush": "^13"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "squizlabs/php_codesniffer": "^4.0",
    "drupal/coder": "^9.0",
    "friendsoftwig/twigcs": "^6.6",
    "drupol/phpcsfixer-configs-drupal": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
